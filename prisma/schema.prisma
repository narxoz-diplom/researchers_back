generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AUTHOR
  SUBSCRIBER
}

enum VideoSource {
  CLOUDINARY
  YOUTUBE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum SubscriptionPlan {
  BASIC
  PRO
}

enum CourseEnrollmentStatus {
  PENDING
  PAID
  UNDERPAID
  APPROVED
  REJECTED
  /// Withdrawn by the student before access was granted.
  CANCELLED
}

enum LessonVectorIndexStatus {
  PENDING
  INDEXING
  READY
  FAILED
}

enum LessonIndexTaskStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LessonGenerationJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// One line of the enrollment journal: who did what to a request and when.
enum EnrollmentEventType {
  REQUESTED
  PAYMENT_SUBMITTED
  MORE_PAYMENT_REQUESTED
  /// Admin/author corrected the recorded amount to what actually arrived.
  AMOUNT_ADJUSTED
  APPROVED
  REJECTED
  CANCELLED
}

/// Admin review of an author's signup (public offer). Only APPROVED authors manage courses.
enum AuthorStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  fullName      String
  role          Role          @default(SUBSCRIBER)
  /// Set only for authors; null for subscribers and admins.
  authorStatus  AuthorStatus?
  avatarUrl     String?
  emailVerified Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorApplication          AuthorApplication?  @relation("AuthorApplication")
  reviewedAuthorApplications AuthorApplication[] @relation("AuthorApplicationReviewer")

  courses                 Course[]                 @relation("CourseAuthor")
  subscriptions           Subscription[]           @relation("UserSubscriptions")
  grantedSubs             Subscription[]           @relation("GrantedBy")
  progress                Progress[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  enrollments             CourseEnrollment[]       @relation("CourseEnrollments")
  approvedEnrollments     CourseEnrollment[]       @relation("ApprovedEnrollments")
  enrollmentEvents        CourseEnrollmentEvent[]  @relation("EnrollmentEventActor")
  authorAiSettings        AuthorAiSettings?
  lessonChatUsage         LessonChatUsage[]
}

/// Public offer filled in by an author at signup; reviewed by an admin.
model AuthorApplication {
  id           String    @id @default(cuid())
  userId       String    @unique
  legalName    String
  iin          String
  phone        String
  city         String
  offerVersion String
  acceptedAt   DateTime
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User  @relation("AuthorApplication", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("AuthorApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model AuthorAiSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  encryptedApiKey String
  keyHint         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformAiSettings {
  id                         String   @id @default("default")
  subscriberChatEncryptedKey String?
  subscriberChatKeyHint      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model LessonChatUsage {
  id           String   @id @default(cuid())
  userId       String
  periodStart  DateTime
  messageCount Int      @default(0)
  tokenCount   Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Founder {
  id          String   @id @default(cuid())
  fullName    String
  position    String
  description String   @db.Text
  videoUrl    String?
  previewUrl  String?
  profileUrl  String?
  bio         String?  @db.Text
  gallery     String[] @default([])
  orderNumber Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, orderNumber])
}

model LandingSection {
  slug          String   @id
  /// Russian text.
  description   String   @db.Text
  points        String[]
  /// Kazakh text, shown when the site language is Kazakh.
  descriptionKk String   @default("") @db.Text
  pointsKk      String[] @default([])
  updatedAt     DateTime @updatedAt
}

model Course {
  id          String       @id @default(cuid())
  authorId    String
  title       String
  description String
  coverUrl    String?
  category    String       @default("publication")
  ratingAvg   Float        @default(0)
  ratingCount Int          @default(0)
  priceCents  Int          @default(499000)
  status      CourseStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author      User               @relation("CourseAuthor", fields: [authorId], references: [id])
  lessons     Lesson[]
  enrollments CourseEnrollment[]

  @@index([authorId, status])
  @@index([status, category])
}

model CourseEnrollment {
  id                  String                 @id @default(cuid())
  courseId            String
  userId              String
  status              CourseEnrollmentStatus @default(PENDING)
  message             String?
  paidAt              DateTime?
  paidAmountCents     Int?
  expectedAmountCents Int?
  adminPaymentNote    String?
  approvedAt          DateTime?
  approvedById        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  course     Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User                    @relation("CourseEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?                   @relation("ApprovedEnrollments", fields: [approvedById], references: [id])
  events     CourseEnrollmentEvent[]

  @@unique([courseId, userId])
  @@index([courseId, status])
  @@index([status, updatedAt])
}

/// Journal of an enrollment: requests, payments, top-up requests, decisions and cancellations.
/// Kept even after the enrollment restarts (a cancelled request bought again), so the admin
/// sees the whole story, not only the current status.
model CourseEnrollmentEvent {
  id             String              @id @default(cuid())
  enrollmentId   String
  type           EnrollmentEventType
  /// Student for their own actions, admin/author for decisions; null if the account is gone.
  actorId        String?
  /// Amount of this payment (PAYMENT_SUBMITTED), in tiyn.
  amountCents    Int?
  /// Running total of the enrollment after this event, in tiyn.
  totalPaidCents Int?
  note           String?
  createdAt      DateTime            @default(now())

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  actor      User?            @relation("EnrollmentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([enrollmentId, createdAt])
  @@index([type, createdAt])
}

model Lesson {
  id                String                  @id @default(cuid())
  courseId          String
  title             String
  content           String                  @db.Text
  orderNumber       Int
  isPublished       Boolean                 @default(false)
  vectorIndexStatus LessonVectorIndexStatus @default(PENDING)
  vectorIndexJobId  String?
  vectorIndexedAt   DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  course            Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videos            LessonVideo[]
  materials         LessonMaterial[]
  progress          Progress[]
  vectorIndexErrors LessonVectorIndexError[]
  indexJobs         LessonIndexJob[]
  generationJobs    LessonGenerationJob[]

  @@unique([courseId, orderNumber])
}

model LessonGenerationJob {
  id              String                    @id @default(cuid())
  lessonId        String
  authorId        String
  status          LessonGenerationJobStatus @default(PROCESSING)
  generationPhase String?
  outputFormat    String?
  content         String?                   @db.Text
  title           String?
  usageJson       Json?
  errorCode       String?
  errorMessage    String?                   @db.Text
  ragRequestId    String?
  ragTaskId       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  completedAt     DateTime?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt])
}

model LessonIndexJob {
  id        String   @id @default(cuid())
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tasks  LessonIndexTask[]

  @@index([lessonId])
}

model LessonIndexTask {
  id        String                @id @default(cuid())
  jobId     String
  taskKey   String
  status    LessonIndexTaskStatus @default(PENDING)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  job LessonIndexJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, taskKey])
  @@index([jobId])
}

model LessonVectorIndexError {
  id           String    @id @default(cuid())
  lessonId     String
  jobId        String
  errorCode    String
  message      String    @db.Text
  source       String
  ragRequestId String?
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, jobId])
}

model LessonVideo {
  id                 String      @id @default(cuid())
  lessonId           String
  title              String
  source             VideoSource @default(CLOUDINARY)
  cloudinaryPublicId String?     @unique
  youtubeVideoId     String?
  url                String
  durationSeconds    Int         @default(0)
  sizeBytes          BigInt?
  orderNumber        Int         @default(1)
  createdAt          DateTime    @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonMaterial {
  id                 String   @id @default(cuid())
  lessonId           String
  title              String
  cloudinaryPublicId String   @unique
  url                String
  mimeType           String
  sizeBytes          BigInt
  createdAt          DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  plan        SubscriptionPlan   @default(BASIC)
  status      SubscriptionStatus @default(ACTIVE)
  startsAt    DateTime           @default(now())
  expiresAt   DateTime
  grantedById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user      User @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("GrantedBy", fields: [grantedById], references: [id])

  @@index([userId, status])
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}
