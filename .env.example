NODE_ENV=development
PORT=8080
# Use 5432 with docker compose postgres; use 5433 if local 5432 is taken
DATABASE_URL=postgresql://researchers:researchers@localhost:5432/researchers
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Researchers.kz <noreply@researchers.kz>
SEED_ADMIN_EMAIL=admin@researchers.local
SEED_ADMIN_PASSWORD=Admin123!
# Set to "true" to expose /docs in production. Defaults to off when NODE_ENV=production.
SWAGGER_ENABLED=
# Express `trust proxy` value (e.g. "1" or "loopback") when behind a reverse proxy.
TRUST_PROXY=
