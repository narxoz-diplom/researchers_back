# =============================================================================
# researchers-api — production environment template
# =============================================================================
# Copy on the VPS: cp .env.production.example .env.production
# NEVER commit the populated .env.production to git.
# Set strict permissions: chmod 600 .env.production
# =============================================================================

# --- Domain & TLS -------------------------------------------------------------
# Public domain served by edge nginx (no scheme, no trailing slash).
DOMAIN=example.com
# Email for Let's Encrypt registration / expiry warnings.
ACME_EMAIL=admin@example.com

# --- Container images ---------------------------------------------------------
# Override with the GHCR repository owner (lowercased GitHub org/user).
IMAGE_OWNER=your-github-owner
# Image tags to deploy. The deploy workflow pins both to the commit SHA;
# the defaults below allow manual `docker compose up` to use latest.
API_IMAGE_TAG=latest
WEB_IMAGE_TAG=latest

# --- API runtime --------------------------------------------------------------
NODE_ENV=production
PORT=8080
# Express trust proxy hop count (we sit behind one nginx).
TRUST_PROXY=1
# /docs (Swagger) is OFF in production by default. Set to "true" to expose it.
SWAGGER_ENABLED=

# --- Database -----------------------------------------------------------------
POSTGRES_USER=researchers
# REQUIRED: generate via `openssl rand -base64 32`
POSTGRES_PASSWORD=
POSTGRES_DB=researchers

# --- JWT ----------------------------------------------------------------------
# REQUIRED: generate each via `openssl rand -base64 64`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS / frontend ----------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=https://example.com
FRONTEND_URL=https://example.com

# --- Cloudinary (optional) ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (optional) ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Researchers.kz <noreply@example.com>

# --- Admin seed (used by manual seed only — NOT executed on container start) --
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Backups ------------------------------------------------------------------
# How often the backup cron runs inside the backup container.
BACKUP_CRON=0 3 * * *
# Number of daily backup files retained on the VPS before pruning.
BACKUP_RETENTION_DAYS=14
# AGE encryption recipient (public key). REQUIRED for encrypted backups.
# Generate locally: `age-keygen -o backup-key.txt` and copy the public key here.
# Keep the matching private key OFFLINE (password manager / secure vault).
BACKUP_AGE_RECIPIENT=
